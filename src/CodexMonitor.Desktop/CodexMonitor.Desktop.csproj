<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- A single project: GUI subsystem on Windows, console host on Unix. -->
    <OutputType Condition="'$(OS)' == 'Windows_NT' Or '$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-arm64'">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CodexMonitor</AssemblyName>
    <RootNamespace>CodexMonitor.Desktop</RootNamespace>
    <Version>0.5.2</Version>
    <Product>Codex Monitor</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CodexMonitor.Core/CodexMonitor.Core.csproj" />
    <ProjectReference Include="../CodexMonitor.Composition/CodexMonitor.Composition.csproj" />
    <ProjectReference Include="../CodexMonitor.Platform.Windows/CodexMonitor.Platform.Windows.csproj" />
    <ProjectReference Include="../CodexMonitor.Platform.Unix/CodexMonitor.Platform.Unix.csproj" />
    <ProjectReference Include="../CodexMonitor.Plugins.Codex/CodexMonitor.Plugins.Codex.csproj" />
    <ProjectReference Include="../CodexMonitor.UI/CodexMonitor.UI.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <EmbeddedResource Include="../../assets/tray.png" LogicalName="CodexMonitor.Tray.png" />
    <EmbeddedResource Include="../../assets/tray.ico" LogicalName="CodexMonitor.Tray.ico" />
  </ItemGroup>
</Project>
