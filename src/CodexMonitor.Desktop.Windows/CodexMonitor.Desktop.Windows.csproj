<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>CodexMonitor</AssemblyName>
    <RootNamespace>CodexMonitor</RootNamespace>
    <Version>0.5.0</Version>
    <Product>Codex Monitor</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CodexMonitor.Core/CodexMonitor.Core.csproj" />
    <ProjectReference Include="../CodexMonitor.Plugins.Codex/CodexMonitor.Plugins.Codex.csproj" />
    <ProjectReference Include="../CodexMonitor.Composition/CodexMonitor.Composition.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <InternalsVisibleTo Include="CodexMonitor.Screenshots" />
  </ItemGroup>
</Project>
