<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodexMonitor.UI.ViewModels"
        xmlns:views="using:CodexMonitor.UI.Views"
        x:Class="CodexMonitor.UI.Views.WorkspaceWindow"
        x:DataType="vm:WorkspaceViewModel" x:CompileBindings="True"
        Title="Codex Monitor · Workspace" Width="1120" Height="740"
        MinWidth="960" MinHeight="570" WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Dark" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Styles>
    <Style Selector="TabControl.workspace-tabs TabItem">
      <Setter Property="Width" Value="182"/>
      <Setter Property="Margin" Value="10,1"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TabControl.workspace-tabs TabItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    </Style>
    <Style Selector="TabControl.workspace-tabs TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="202,*" RowDefinitions="64,*">
    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource WindowBrush}"
            BorderBrush="#29323D" BorderThickness="0,0,1,1" Padding="20,0">
      <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
        <PathIcon Width="25" Height="25" Foreground="{DynamicResource AccentBrush}"
                  Data="M3,2 L18,2 L15,6 L7,6 L4,10 L17,10 L20,14 L17,18 L3,18 L6,14 L14,14 L17,10 L4,10 L1,6 Z"/>
        <TextBlock Text="CodexMonitor" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource WindowBrush}"
            BorderBrush="#29323D" BorderThickness="0,0,0,1" Padding="26,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <TextBlock Text="Workspace" Foreground="#8795A3" FontSize="12"/>
          <TextBlock Text="›" Foreground="#8795A3" FontSize="13"/>
          <TextBlock Text="{Binding CurrentPageName}" Foreground="{DynamicResource TextBrush}" FontSize="12"
                     FontWeight="SemiBold"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Usage.ProviderName}"
                   FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
        <Button Grid.Column="2" Content="↻" Command="{Binding RefreshOverviewCommand}"
                IsEnabled="{Binding !IsOverviewBusy}" Width="32" Height="32"
                Background="Transparent" Foreground="{DynamicResource MutedBrush}"
                Padding="4" FontSize="17" ToolTip.Tip="Refresh limits and local workspace"/>
        <TextBlock Grid.Column="3" Text="LOCAL" FontSize="10" FontWeight="SemiBold"
                   VerticalAlignment="Center" Foreground="#8795A3"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource WindowBrush}"
            BorderBrush="#29323D" BorderThickness="0,0,1,0"/>
    <TabControl Grid.Row="1" Grid.ColumnSpan="2" Classes="workspace-tabs" TabStripPlacement="Left" SelectedIndex="{Binding SelectedPage, Mode=TwoWay}"
                Background="Transparent" BorderThickness="0" Padding="0">
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <PathIcon Width="15" Height="15" Data="M2,2 L8,2 L8,8 L2,8 Z M12,2 L18,2 L18,8 L12,8 Z M2,12 L8,12 L8,18 L2,18 Z M12,12 L18,12 L18,18 L12,18 Z"/>
            <TextBlock Text="Overview" FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <views:WorkspaceOverviewView/>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <PathIcon Width="15" Height="15" Data="M2,5 L8,5 L10,7 L18,7 L18,17 L2,17 Z"/>
            <TextBlock Text="Projects" FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="40,30" Spacing="18" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="Projects" FontSize="30" FontWeight="SemiBold" Foreground="#F1F4F8"/>
            <TextBlock Text="Inspect a local repository. Nothing leaves your computer." FontSize="13" Foreground="#B2BECA"/>
            <TextBlock Text="Saved repositories" FontSize="12" Foreground="#B2BECA"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                        MinWidth="380" HorizontalAlignment="Stretch"/>
              <Button Grid.Column="1" Content="Open selected" Command="{Binding LoadProjectCommand}"/>
            </Grid>
            <TextBlock Text="Repository directory" FontSize="12" Foreground="#B2BECA"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Text="{Binding ProjectPath, Mode=TwoWay}" Watermark="Paste a local repository path"
                       MinWidth="380"/>
              <Button Grid.Column="1" Content="Inspect" Command="{Binding InspectProjectCommand}"
                      IsEnabled="{Binding !IsLoading}"/>
            </Grid>
            <TextBlock Text="{Binding ProjectStatus}" FontSize="12" TextWrapping="Wrap" Foreground="#B2BECA"/>
            <TextBlock Text="{Binding ProjectName}" FontSize="22" FontWeight="SemiBold" Foreground="#F1F4F8"/>
            <Grid ColumnDefinitions="190,Auto,*" ColumnSpacing="10">
              <ComboBox ItemsSource="{Binding GitImpactScopes}" SelectedItem="{Binding GitImpactSelection, Mode=TwoWay}"/>
              <Button Grid.Column="1" Content="Recalculate" Command="{Binding InspectProjectCommand}" IsEnabled="{Binding !IsLoading}"/>
            </Grid>
            <TextBlock Text="{Binding GitBranch}" Foreground="#B2BECA" FontSize="12"/>
            <TextBlock Text="{Binding GitSummary}" Foreground="#63D9C6" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding GitDetails}" Foreground="#B2BECA" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="Files in selected comparison" FontSize="15" Foreground="#F1F4F8" FontWeight="SemiBold"/>
            <ListBox ItemsSource="{Binding ProjectFiles}" MinHeight="150" MaxHeight="340"/>
            <TextBlock Text="Line counts reflect the selected Git diff, not verified agent authorship."
                       FontSize="12" Foreground="#8795A3" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <PathIcon Width="15" Height="15" Data="M1,11 L5,11 L7,5 L10,16 L13,8 L15,11 L19,11"/>
            <TextBlock Text="Usage" FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="40,30" Spacing="18" MaxWidth="850" HorizontalAlignment="Left">
            <TextBlock Text="Usage" FontSize="30" FontWeight="SemiBold" Foreground="#F1F4F8"/>
            <TextBlock Text="Limits and token activity from the selected provider." Foreground="#B2BECA"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
              <Border Background="#1D232B" BorderBrush="#313A45" BorderThickness="1" CornerRadius="9" Padding="24">
                <StackPanel Spacing="9">
                  <TextBlock Text="CURRENT WINDOW" Foreground="#8795A3" FontWeight="SemiBold" FontSize="11"/>
                  <TextBlock Text="{Binding Usage.LimitTitle}" Foreground="#F1F4F8" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Usage.RemainingText}" Foreground="#63D9C6" FontSize="30" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Usage.ResetText}" Foreground="#B2BECA" FontSize="12" TextWrapping="Wrap"/>
                  <Button Content="Refresh limits" Command="{Binding Usage.RefreshLimitsCommand}"
                          IsEnabled="{Binding Usage.CanRefreshLimits}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#1D232B" BorderBrush="#313A45" BorderThickness="1" CornerRadius="9" Padding="24"
                      IsVisible="{Binding Usage.SupportsTokens}">
                <StackPanel Spacing="9">
                  <TextBlock Text="TOKEN ACTIVITY" Foreground="#8795A3" FontWeight="SemiBold" FontSize="11"/>
                  <TextBlock Text="{Binding Usage.LatestTokens}" Foreground="#F1F4F8" FontSize="30" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Usage.Lifetime}" Foreground="#B2BECA" FontSize="13"/>
                  <TextBlock Text="{Binding Usage.Peak}" Foreground="#B2BECA" FontSize="13"/>
                  <Button Content="Refresh tokens" Command="{Binding Usage.RefreshTokensCommand}"
                          IsEnabled="{Binding Usage.CanRefreshTokens}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="Other limit windows" FontSize="18" Foreground="#F1F4F8" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding Usage.OtherLimits}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LimitWindowItem">
                  <Border BorderBrush="#313A45" BorderThickness="0,0,0,1" Padding="0,12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Text="{Binding Label}" Foreground="#F1F4F8" FontSize="14"/>
                      <TextBlock Grid.Column="1" Text="{Binding UsedPercent, StringFormat={}{0:0}% used}" Foreground="#63D9C6"/>
                      <TextBlock Grid.Row="1" Text="{Binding ResetText}" Foreground="#B2BECA" FontSize="12"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <PathIcon Width="15" Height="15" Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M10,6 A4,4 0 1 0 10,14 A4,4 0 1 0 10,6"/>
            <TextBlock Text="Goals" FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="40,30" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Goal budget" FontSize="30" FontWeight="SemiBold" Foreground="#F1F4F8"/>
            <TextBlock Text="Plan your next task for the selected project. Goals are stored locally."
                       TextWrapping="Wrap" Foreground="#B2BECA"/>
            <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" FontSize="16" Foreground="#F1F4F8"/>
            <TextBlock Text="Goal" FontSize="12" Foreground="#B2BECA"/>
            <TextBox Text="{Binding GoalTitle, Mode=TwoWay}" Watermark="e.g. Finish core refactor"
                     MinWidth="400"/>
            <TextBlock Text="Time budget in minutes" FontSize="12" Foreground="#B2BECA"/>
            <TextBox Text="{Binding BudgetText, Mode=TwoWay}" Width="120"
                     HorizontalAlignment="Left"/>
            <Button Content="Save goal" Command="{Binding SaveGoalCommand}"
                    HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding GoalStatus}" TextWrapping="Wrap" Foreground="#B2BECA"/>
            <TextBlock Text="A budget is a planned maximum, not a measured completion percentage."
                       TextWrapping="Wrap" FontSize="12" Foreground="#8795A3"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <PathIcon Width="15" Height="15" Data="M10,2 L18,6 L18,14 L10,18 L2,14 L2,6 Z M2,6 L10,10 L18,6 M10,10 L10,18"/>
            <TextBlock Text="Skills" FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="40,30" Spacing="15" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Skills manager" FontSize="30" FontWeight="SemiBold" Foreground="#F1F4F8"/>
            <TextBlock Text="Installed skills and reviewed local installs. No separate sign-in."
                       FontSize="13" Foreground="#B2BECA" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{Binding SkillsSummary}" Foreground="#B2BECA" FontSize="13" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="Rescan" Command="{Binding RefreshSkillsCommand}"/>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
              <StackPanel Spacing="10">
                <TextBlock Text="Installed" Foreground="#F1F4F8" FontSize="17" FontWeight="SemiBold"/>
                <ListBox ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkill, Mode=TwoWay}"
                         MinHeight="180" MaxHeight="260"/>
                <Button Content="Read SKILL.md" Command="{Binding ReadSelectedSkillCommand}" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock Text="Skill details" Foreground="#F1F4F8" FontSize="17" FontWeight="SemiBold"/>
                <TextBox Text="{Binding SkillDetails}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="215" FontFamily="Consolas, monospace"/>
              </StackPanel>
            </Grid>
            <Border BorderBrush="#313A45" BorderThickness="0,1,0,0" Padding="0,20,0,0">
              <StackPanel Spacing="10">
                <TextBlock Text="Install from local folder" Foreground="#F1F4F8" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Review contents and scripts before making local file changes."
                           FontSize="12" Foreground="#B2BECA"/>
                <Grid ColumnDefinitions="*,150" ColumnSpacing="10">
                  <TextBox Text="{Binding SkillSourceFolder, Mode=TwoWay}" Watermark="Source folder containing SKILL.md"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding SkillScopes}"
                            SelectedItem="{Binding SkillInstallScope, Mode=TwoWay}"/>
                </Grid>
                <Button Content="Preview installation" Command="{Binding ReviewSkillCommand}" HorizontalAlignment="Left"/>
                <TextBox Text="{Binding SkillReviewText}" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" MinHeight="120" MaxHeight="220" FontFamily="Consolas, monospace"/>
                <CheckBox IsChecked="{Binding ConfirmSkillInstall, Mode=TwoWay}"
                          Content="I reviewed the files and approve installation"/>
                <Button Content="Install reviewed skill" IsEnabled="{Binding CanInstallSkill}"
                        Command="{Binding InstallReviewedSkillCommand}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding SkillInstallStatus}" Foreground="#B2BECA" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock Text="Remote marketplace discovery, updates and uninstall are not yet available."
                           Foreground="#8795A3" TextWrapping="Wrap" FontSize="12"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <PathIcon Width="15" Height="15" Data="M5,2 L13,2 L17,6 L17,18 L5,18 Z M13,2 L13,6 L17,6 M8,10 L14,10 M8,13 L14,13"/>
            <TextBlock Text="AGENTS.md" FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="40,30" Spacing="14" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="AGENTS.md Studio" FontSize="30" FontWeight="SemiBold" Foreground="#F1F4F8"/>
            <TextBlock Text="Inspect nested instructions, review a proposed rewrite, then explicitly approve saving."
                       Foreground="#B2BECA" TextWrapping="Wrap" FontSize="13"/>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <ComboBox ItemsSource="{Binding InstructionFiles}"
                        SelectedItem="{Binding SelectedInstructionPath, Mode=TwoWay}"
                        MinWidth="390"/>
              <Button Grid.Column="1" Content="Read" Command="{Binding ReadInstructionCommand}"/>
              <Button Grid.Column="2" Content="Inspect" Command="{Binding AnalyzeInstructionsCommand}"/>
            </Grid>
            <TextBlock Text="{Binding InstructionsAuditText}" Foreground="#B2BECA" FontSize="12" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <StackPanel Spacing="8">
                <TextBlock Text="Current file" FontWeight="SemiBold" Foreground="#F1F4F8" FontSize="16"/>
                <TextBox Text="{Binding Instructions}" AcceptsReturn="True" IsReadOnly="True"
                         TextWrapping="Wrap" MinHeight="300" FontFamily="Consolas, monospace"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="AI proposal" FontWeight="SemiBold" Foreground="#F1F4F8" FontSize="16"/>
                <TextBox Text="{Binding InstructionsProposedText}" AcceptsReturn="True" IsReadOnly="True"
                         TextWrapping="Wrap" MinHeight="300" FontFamily="Consolas, monospace"/>
              </StackPanel>
            </Grid>
            <Button Content="Generate proposed rewrite with Codex" Command="{Binding OptimizeInstructionsCommand}"
                    IsEnabled="{Binding !IsOptimizingInstructions}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding InstructionsRationale}" TextWrapping="Wrap" Foreground="#B2BECA"/>
            <TextBlock Text="{Binding InstructionsOperationStatus}" TextWrapping="Wrap" Foreground="#B2BECA" FontSize="12"/>
            <CheckBox Content="I reviewed the proposal and approve replacing this AGENTS.md"
                      IsChecked="{Binding ConfirmInstructionsApply, Mode=TwoWay}"/>
            <Button Content="Apply approved proposal (save backup)" Command="{Binding ApplyInstructionsCommand}"
                    IsEnabled="{Binding CanApplyInstructions}" HorizontalAlignment="Left"/>
            <TextBlock Text="AI uses the existing Codex CLI login, consumes quota only on request, and cannot save without approval."
                       TextWrapping="Wrap" Foreground="#8795A3" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <PathIcon Width="15" Height="15" Data="M10,1 L12,7 L18,9 L12,11 L10,18 L8,11 L2,9 L8,7 Z"/>
            <TextBlock Text="Planner" FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="40,30" Spacing="16" MaxWidth="810" HorizontalAlignment="Left">
            <TextBlock Text="Work planner" FontSize="30" FontWeight="SemiBold" Foreground="#F1F4F8"/>
            <TextBlock Text="Lightweight guidance, without starting an AI agent." Foreground="#B2BECA"/>
            <TextBlock Text="{Binding AdvisorText}" FontSize="17" TextWrapping="Wrap" Foreground="#F1F4F8"/>
            <TextBlock Text="Evidence and limitations" Foreground="#B2BECA" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding AdvisorEvidence}" Foreground="#B2BECA" FontSize="12" TextWrapping="Wrap"/>
            <Border BorderBrush="#313A45" BorderThickness="0,1,0,0" Padding="0,20,0,0">
              <StackPanel Spacing="10">
                <TextBlock Text="Codex AI Advisor" FontSize="18" Foreground="#F1F4F8" FontWeight="SemiBold"/>
                <TextBlock Text="Uses only aggregate quota, observed session status and your goal."
                           Foreground="#B2BECA" FontSize="12" TextWrapping="Wrap"/>
                <Button Content="Analyze with Codex" Command="{Binding AskAiPlannerCommand}"
                        IsEnabled="{Binding !IsAdvisorBusy}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding AiAdvisorText}" FontSize="14" TextWrapping="Wrap" Foreground="#F1F4F8"/>
                <TextBlock Text="{Binding AiAdvisorStatus}" FontSize="12" TextWrapping="Wrap" Foreground="#B2BECA"/>
              </StackPanel>
            </Border>
            <TextBlock Text="AI recommendations are optional; no model is called by the local planner."
                       Foreground="#8795A3" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <PathIcon Width="15" Height="15" Data="M1,11 L5,11 L8,3 L11,16 L14,9 L17,9 L19,11"/>
            <TextBlock Text="Activity" FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="40,30" Spacing="16" MaxWidth="850" HorizontalAlignment="Left">
            <TextBlock Text="Activity" FontSize="30" FontWeight="SemiBold" Foreground="#F1F4F8"/>
            <TextBlock Text="Observed Codex events. No assumption of universal live-session coverage."
                       Foreground="#B2BECA" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ActivityCoverage}" Foreground="#B2BECA" TextWrapping="Wrap" FontSize="12"/>
            <Border BorderBrush="#313A45" BorderThickness="0,0,0,1" Padding="0,12">
              <TextBlock Text="{Binding ActivityAttention}" Foreground="#63D9C6" TextWrapping="Wrap" FontSize="14"/>
            </Border>
            <Button Content="Refresh observations" Command="{Binding RefreshActivityCommand}"
                    HorizontalAlignment="Left"/>
            <ListBox ItemsSource="{Binding ActivityItems}" MinHeight="180"/>
            <TextBlock Text="Optional setup for Codex CLI" FontWeight="SemiBold" Foreground="#F1F4F8"/>
            <TextBox Text="{Binding NotifySetup}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="80" FontFamily="Consolas, monospace"/>
            <TextBlock Text="Only event metadata is recorded. Existing Codex authorization is reused."
                       Foreground="#8795A3" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <PathIcon Width="15" Height="15" Data="M8,2 L12,2 L12,7 L17,7 L17,12 L12,12 L12,17 L8,17 L8,12 L3,12 L3,7 L8,7 Z"/>
            <TextBlock Text="Doctor" FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="40,30" Spacing="16" MaxWidth="890" HorizontalAlignment="Left">
            <TextBlock Text="Agent doctor" FontSize="30" FontWeight="SemiBold" Foreground="#F1F4F8"/>
            <TextBlock Text="Local diagnostics: detected agents, Git, skills, instructions and event collection."
                       Foreground="#B2BECA" FontSize="13" TextWrapping="Wrap"/>
            <Button Content="Run local checks" Command="{Binding RefreshDoctorCommand}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding DoctorSummary}" Foreground="#B2BECA" TextWrapping="Wrap" FontSize="12"/>
            <ItemsControl ItemsSource="{Binding DoctorItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DoctorCheckItem">
                  <Border BorderBrush="#313A45" BorderThickness="0,0,0,1" Padding="0,12">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Category}" Foreground="#8795A3" FontSize="12" Width="90"/>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F1F4F8"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#63D9C6" FontSize="12"/>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}"
                                 Foreground="#B2BECA" FontSize="12" TextWrapping="Wrap"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="NotImplemented means this agent has no adapter; no login can fix it."
                       Foreground="#8795A3" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="11">
            <PathIcon Width="15" Height="15" Data="M2,3 L18,3 L18,17 L2,17 Z M5,7 L8,10 L5,13 M10,13 L15,13"/>
            <TextBlock Text="Sessions" FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Margin="40,30" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Sessions" FontSize="30" FontWeight="SemiBold" Foreground="#F1F4F8"/>
            <TextBlock Text="Read-only Codex history from an isolated App Server connection."
                       Foreground="#B2BECA" TextWrapping="Wrap" FontSize="13"/>
            <Button Content="Read saved sessions" Command="{Binding RefreshSessionsCommand}"
                    IsEnabled="{Binding !IsLoadingSessions}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding SessionsStatus}" TextWrapping="Wrap" Foreground="#B2BECA" FontSize="12"/>
            <ItemsControl ItemsSource="{Binding SessionItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionItem">
                  <Border BorderBrush="#313A45" BorderThickness="0,0,0,1" Padding="0,12">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                      <TextBlock Text="{Binding Name}" Foreground="#F1F4F8" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="#63D9C6" FontSize="12"/>
                      <TextBlock Grid.Row="1" Text="{Binding Project}" Foreground="#B2BECA"
                                 TextWrapping="Wrap" FontSize="12"/>
                      <TextBlock Grid.Row="2" Text="{Binding LastUpdated}" Foreground="#8795A3" FontSize="11"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="notLoaded is not an idle signal. This window never resumes or modifies a session."
                       Foreground="#8795A3" TextWrapping="Wrap" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
