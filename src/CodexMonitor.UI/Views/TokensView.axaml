<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CodexMonitor.UI.ViewModels"
             x:Class="CodexMonitor.UI.Views.TokensView"
             x:DataType="vm:DashboardViewModel"
             x:CompileBindings="True">
  <StackPanel Spacing="12" Margin="0,12,0,0">
    <Border Background="#202732" CornerRadius="12" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding TokenDate}" FontSize="11"
                   Foreground="#9CA9BA" />
        <TextBlock Text="{Binding LatestTokens}" FontSize="29"
                   FontWeight="Bold" Foreground="#F5F7FB" />
        <Grid ColumnDefinitions="*,*">
          <TextBlock Grid.Column="0" Text="{Binding Lifetime}" FontSize="11" />
          <TextBlock Grid.Column="1" Text="{Binding Peak}" FontSize="11" />
        </Grid>
      </StackPanel>
    </Border>
    <TextBlock Text="DAILY TOKENS · RECENT 7 DAYS" FontWeight="Bold"
               FontSize="11" Foreground="#9CA9BA" />
    <ItemsControl ItemsSource="{Binding RecentDays}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TokenDayItem">
          <StackPanel Spacing="5" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding DateText}" FontSize="12" />
              <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12" />
            </Grid>
            <ProgressBar Minimum="0" Maximum="100"
                         Value="{Binding Percentage}" Height="11" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding TokenError}" IsVisible="{Binding HasTokenError}"
               Foreground="#F58B8B" TextWrapping="Wrap" FontSize="11" />
    <Button Content="Refresh token activity" HorizontalAlignment="Left"
            Command="{Binding RefreshTokensCommand}"
            IsEnabled="{Binding CanRefreshTokens}" />
  </StackPanel>
</UserControl>
